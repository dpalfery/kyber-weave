<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>KyberWeave.Data</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>KyberWeave</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyberWeave.Contracts\KyberWeave.Contracts.csproj" />
    <ProjectReference Include="..\KyberWeave.Kernel\KyberWeave.Kernel.csproj" />
    <ProjectReference Include="..\KyberWeave.Domain\KyberWeave.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KyberWeave.Application.Tests" />
    <InternalsVisibleTo Include="KyberWeave.Core" />
    <InternalsVisibleTo Include="KyberWeave.Application" />
    <!-- The provider's transport constructor is driven directly by the embedding client tests. -->
    <InternalsVisibleTo Include="KyberWeave.Tests" />
    <InternalsVisibleTo Include="KyberWeave.Integration.Tests" />
    <InternalsVisibleTo Include="KyberWeave.Testing" />
    <!-- Temporary: the closeout gates still in the engine read the bounded reader and PresentFile
         until they move. Drop this entry when the last caller of either leaves KyberWeave.Core.Docs. -->
    <InternalsVisibleTo Include="KyberWeave.Core.Docs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Each area owns one Areas\<Area>.props for its resources and package references, so parallel moves never edit the same lines. -->
  <Import Project="Areas\*.props" />

</Project>
