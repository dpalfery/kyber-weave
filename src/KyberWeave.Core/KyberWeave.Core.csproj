<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>KyberWeave.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>KyberWeave</Authors>
    <Description>The Kyber-Weave engine: parses, validates, security-scans and drift-checks the artifacts that shape agent behaviour — skills, agent definitions and documentation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- The legacy engine is being drained into these layers (ADR 0057 split, superseded by the layering
         in LayerReferenceTests). It references them; they never reference it. -->
    <ProjectReference Include="..\KyberWeave.Kernel\KyberWeave.Kernel.csproj" />
    <ProjectReference Include="..\KyberWeave.Domain\KyberWeave.Domain.csproj" />
    <ProjectReference Include="..\KyberWeave.Contracts\KyberWeave.Contracts.csproj" />
    <ProjectReference Include="..\KyberWeave.Data\KyberWeave.Data.csproj" />
    <ProjectReference Include="..\KyberWeave.Application\KyberWeave.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The forwarders left here (review config merge, section readers) are unit-tested directly
         rather than only through the public command surface. -->
    <InternalsVisibleTo Include="KyberWeave.Tests" />
    <InternalsVisibleTo Include="KyberWeave.Integration.Tests" />
    <InternalsVisibleTo Include="KyberWeave.Testing" />
    <!--
      Core.Docs reads two internals of the forwarders left here: ProjectRootDetector and ReviewConfigLoader.Merge.
      Core.Squad holds no source any more; CoreAssemblySplitTests pins its project reference. The grant is
      assembly-wide, so it exposes every Core internal to them; reach for another only by stating why here.
    -->
    <InternalsVisibleTo Include="KyberWeave.Core.Squad" />
  </ItemGroup>

</Project>
