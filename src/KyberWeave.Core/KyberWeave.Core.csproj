<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>KyberWeave.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>KyberWeave</Authors>
    <Description>The Kyber-Weave engine: parses, validates, security-scans and drift-checks the artifacts that shape agent behaviour — skills, agent definitions and documentation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The LibraryImport source generator emits unsafe pinning code for the advapi32
      string marshalling in Arbiter/Credentials/WindowsCredentialStore.cs (CredWriteW /
      CredReadW take UTF-16 strings). The unsafe is confined to those generated stubs,
      which never load off Windows: every call site is gated by
      OperatingSystem.IsWindows(). AllowUnsafeBlocks applies assembly-wide, so it
      permits hand-written unsafe too; none is present, and a source-scan test guards
      that invariant.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Internal helpers (link normalization, vocabulary parsing) are unit-tested
         directly rather than only through the public command surface. -->
    <InternalsVisibleTo Include="KyberWeave.Tests" />
    <!-- The Squad engine is its own assembly and still reads Core's path semantics. -->
    <InternalsVisibleTo Include="KyberWeave.Core.Squad" />
    <!-- The Docs engine is its own assembly and still reads Core's ontology defaults. -->
    <InternalsVisibleTo Include="KyberWeave.Core.Docs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each technology's gate catalogue, embedded from products/kyber-squad/standards. The
         standards templates beside them belong to KyberWeave.Core.Docs. -->
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\csharp\gates.yml" LogicalName="Gates.csharp.yml" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\typescript\gates.yml" LogicalName="Gates.typescript.yml" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\rust\gates.yml" LogicalName="Gates.rust.yml" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\go\gates.yml" LogicalName="Gates.go.yml" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\python\gates.yml" LogicalName="Gates.python.yml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 18 shipped Arbiter rules plus the OWNER-001 file-kind map and the
         LENS-001 step-0 path table: the single source of truth for defaults. -->
    <EmbeddedResource Include="Arbiter\Rules\default-rules.yml" LogicalName="Arbiter.default-rules.yml" />
    <!-- Embedded Squad copies the Arbiter reads in host repositories without a
         canonical tree. Logical names mirror the Standards.* convention and avoid
         the raw-corpus tokens the release test forbids in resource names. -->
    <EmbeddedResource Include="..\..\products\kyber-squad\agents\*.md" LogicalName="Arbiter.Roster.%(Filename).md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\skills\code-review\references\lenses\*.md" LogicalName="Arbiter.Lens.%(Filename).md" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Compile-time only, and PrivateAssets="all" keeps it out of the shipped nupkg's
      dependency graph: consumers of KyberWeave.Core still take only Markdig and YamlDotNet.
      It is here because two analyzers disagree — ReSharper reports the conventional
      exception constructors CA1032 requires as unused, and [UsedImplicitly] is the
      sanctioned way to say "constructed by something you cannot see".
    -->
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
