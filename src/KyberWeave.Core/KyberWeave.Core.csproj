<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>KyberWeave.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>KyberWeave</Authors>
    <Description>The Kyber-Weave engine: parses, validates, security-scans and drift-checks the artifacts that shape agent behaviour — skills, agent definitions and documentation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- Internal helpers (link normalization, vocabulary parsing) are unit-tested
         directly rather than only through the public command surface. -->
    <InternalsVisibleTo Include="KyberWeave.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rich coding standards templates embedded from products/kyber-squad/standards -->
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\azure\README.md" LogicalName="Standards.azure.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\csharp\README.md" LogicalName="Standards.csharp.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\data-access-layer\README.md" LogicalName="Standards.data-access-layer.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\github-actions\README.md" LogicalName="Standards.github-actions.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\go\README.md" LogicalName="Standards.go.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\maui\README.md" LogicalName="Standards.maui.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\pulumi\README.md" LogicalName="Standards.pulumi.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\python\README.md" LogicalName="Standards.python.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\react\README.md" LogicalName="Standards.react.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\rust\README.md" LogicalName="Standards.rust.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\sql\README.md" LogicalName="Standards.sql.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\tauri\README.md" LogicalName="Standards.tauri.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\test\README.md" LogicalName="Standards.test.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\typescript\README.md" LogicalName="Standards.typescript.md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\csharp\gates.yml" LogicalName="Gates.csharp.yml" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\typescript\gates.yml" LogicalName="Gates.typescript.yml" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\rust\gates.yml" LogicalName="Gates.rust.yml" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\go\gates.yml" LogicalName="Gates.go.yml" />
    <EmbeddedResource Include="..\..\products\kyber-squad\standards\python\gates.yml" LogicalName="Gates.python.yml" />
    <!--
      The user-home response guidance a global `squad update` deploys to
      ~/.kyber-weave/response-guidance.md. The default text ships as a resource so an installed
      tool needs no checkout beside it to know its own default; the copy is byte-identical to the
      canonical skill file, and the VerifyResponseGuidanceDefault target below fails the build if
      the two ever diverge. It is deliberately not an EmbeddedResource of the product path: the
      release-artifact rule keeps the Squad corpus out of these assemblies, and a Core-owned
      resource is the shape that rule permits.
    -->
    <EmbeddedResource Include="Squad\Deployment\Resources\response-guidance.default.md" LogicalName="Squad.response-guidance.md" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Byte-for-byte drift guard for the response-guidance default above. The copy exists because a
      deployed tool cannot read the product tree it was built from, and this is what keeps the copy
      honest: editing either file alone fails the build instead of shipping two different defaults.
    -->
    <CanonicalResponseGuidance Include="$(MSBuildThisFileDirectory)..\..\products\kyber-squad\skills\response-format\user-guidance.md" />
    <ShippedResponseGuidance Include="$(MSBuildThisFileDirectory)Squad\Deployment\Resources\response-guidance.default.md" />
  </ItemGroup>

  <Target Name="VerifyResponseGuidanceDefault" BeforeTargets="PrepareForBuild">
    <GetFileHash Files="@(CanonicalResponseGuidance)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_CanonicalResponseGuidanceHash" />
    </GetFileHash>
    <GetFileHash Files="@(ShippedResponseGuidance)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_ShippedResponseGuidanceHash" />
    </GetFileHash>
    <Error
      Condition="'$(_CanonicalResponseGuidanceHash)' != '$(_ShippedResponseGuidanceHash)'"
      Text="The response-guidance default shipped in KyberWeave.Core (src/KyberWeave.Core/Squad/Deployment/Resources/response-guidance.default.md) has drifted from its canonical source (products/kyber-squad/skills/response-format/user-guidance.md). Update the copy so the deployed default is the one the response-format skill documents." />
  </Target>

  <ItemGroup>
    <!--
      Compile-time only, and PrivateAssets="all" keeps it out of the shipped nupkg's
      dependency graph: consumers of KyberWeave.Core still take only Markdig and YamlDotNet.
      It is here because two analyzers disagree — ReSharper reports the conventional
      exception constructors CA1032 requires as unused, and [UsedImplicitly] is the
      sanctioned way to say "constructed by something you cannot see".
    -->
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
