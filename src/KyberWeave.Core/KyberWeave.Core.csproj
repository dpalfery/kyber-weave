<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>KyberWeave.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>KyberWeave</Authors>
    <Description>The Kyber-Weave engine: parses, validates, security-scans and drift-checks the artifacts that shape agent behaviour — skills, agent definitions and documentation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- This project holds no source files; see AGENTS.md. The reference set is what LayerReferenceTests pins:
         nothing above these layers, so code that needs Data or Application belongs in the host or that layer. -->
    <ProjectReference Include="..\KyberWeave.Kernel\KyberWeave.Kernel.csproj" />
    <ProjectReference Include="..\KyberWeave.Domain\KyberWeave.Domain.csproj" />
    <ProjectReference Include="..\KyberWeave.Contracts\KyberWeave.Contracts.csproj" />
  </ItemGroup>

  <!-- No InternalsVisibleTo: the project declares no internal member to expose. Add one with the first
       internal type, not in advance. -->


</Project>
