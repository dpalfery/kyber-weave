<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KyberWeave.Hooks</RootNamespace>
    <AssemblyName>kyber-weave-hooks</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kyber-weave-hooks</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>KyberWeave.Hooks</PackageId>
    <Authors>KyberWeave</Authors>
    <Description>Kyber-Weave edit hook: lints, formats and optionally tests a file right after a coding agent edits it.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KyberWeave.Hooks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyberWeave.Application\KyberWeave.Application.csproj" />
    <ProjectReference Include="..\KyberWeave.Contracts\KyberWeave.Contracts.csproj" />
    <ProjectReference Include="..\KyberWeave.Domain\KyberWeave.Domain.csproj" />
    <ProjectReference Include="..\KyberWeave.Kernel\KyberWeave.Kernel.csproj" />
  </ItemGroup>

</Project>
