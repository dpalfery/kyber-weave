<Project>

  <ItemGroup>
    <!--
      The one pull request description format, which the create-pull-request skill and the deliver
      tool both fill. The binaries embed no Squad corpus, so this is a copy of the skill's file, and
      the build fails when the two differ: editing either alone cannot ship two formats.

      Paths are anchored at the project directory, because this file sits in Areas/.
    -->
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\Docs\Delivery\Resources\pull-request-description.md" LogicalName="Delivery.pull-request-description.md" />
    <CanonicalPullRequestDescription Include="$(MSBuildProjectDirectory)\..\..\products\kyber-squad\skills\create-pull-request\assets\pull-request-description.md" />
    <ShippedPullRequestDescription Include="$(MSBuildProjectDirectory)\Docs\Delivery\Resources\pull-request-description.md" />
  </ItemGroup>

  <Target Name="VerifyPullRequestDescription" BeforeTargets="PrepareForBuild">
    <GetFileHash Files="@(CanonicalPullRequestDescription)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_CanonicalPullRequestDescriptionHash" />
    </GetFileHash>
    <GetFileHash Files="@(ShippedPullRequestDescription)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_ShippedPullRequestDescriptionHash" />
    </GetFileHash>
    <Error
      Condition="'$(_CanonicalPullRequestDescriptionHash)' != '$(_ShippedPullRequestDescriptionHash)'"
      Text="The pull request description template shipped in KyberWeave.Application (src/KyberWeave.Application/Docs/Delivery/Resources/pull-request-description.md) has drifted from its canonical source (products/kyber-squad/skills/create-pull-request/assets/pull-request-description.md). Copy the canonical file over it." />
  </Target>

</Project>
