<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>KyberWeave.Core.Squad</PackageId>
    <Version>0.1.0</Version>
    <Authors>KyberWeave</Authors>
    <Description>The Kyber-Squad engine: renders, deploys, verifies and recovers the agent and skill corpus across every supported coding harness.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KyberWeave.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The user-home response guidance a global `squad update` deploys to
      ~/.kyber-weave/response-guidance.md. The default text ships as a resource so an installed
      tool needs no checkout beside it to know its own default; the copy is byte-identical to the
      canonical product file, and the VerifyResponseGuidanceDefault target below fails the build if
      the two ever diverge. It is deliberately not an EmbeddedResource of the product path: the
      release-artifact rule keeps the Squad corpus out of these assemblies, and a resource owned by
      this project is the shape that rule permits.
    -->
    <EmbeddedResource Include="Deployment\Resources\response-guidance.default.md" LogicalName="Squad.response-guidance.md" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Byte-for-byte drift guard for the response-guidance default above. The copy exists because a
      deployed tool cannot read the product tree it was built from, and this is what keeps the copy
      honest: editing either file alone fails the build instead of shipping two different defaults.
    -->
    <CanonicalResponseGuidance Include="$(MSBuildThisFileDirectory)..\..\products\kyber-squad\response-guidance.default.md" />
    <ShippedResponseGuidance Include="$(MSBuildThisFileDirectory)Deployment\Resources\response-guidance.default.md" />
  </ItemGroup>

  <Target Name="VerifyResponseGuidanceDefault" BeforeTargets="PrepareForBuild">
    <GetFileHash Files="@(CanonicalResponseGuidance)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_CanonicalResponseGuidanceHash" />
    </GetFileHash>
    <GetFileHash Files="@(ShippedResponseGuidance)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_ShippedResponseGuidanceHash" />
    </GetFileHash>
    <Error
      Condition="'$(_CanonicalResponseGuidanceHash)' != '$(_ShippedResponseGuidanceHash)'"
      Text="The response-guidance default shipped in KyberWeave.Core.Squad (src/KyberWeave.Core.Squad/Deployment/Resources/response-guidance.default.md) has drifted from its canonical source (products/kyber-squad/response-guidance.default.md). Update the copy so the deployed default is the one the canonical product file states." />
  </Target>

  <ItemGroup>
    <!-- Compile-time only, as in KyberWeave.Core: see the note there. -->
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyberWeave.Core\KyberWeave.Core.csproj" />
  </ItemGroup>

</Project>
