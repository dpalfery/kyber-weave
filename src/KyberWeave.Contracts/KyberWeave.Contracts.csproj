<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>KyberWeave.Contracts</RootNamespace>
    <Authors>KyberWeave</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyberWeave.Kernel\KyberWeave.Kernel.csproj" />
    <ProjectReference Include="..\KyberWeave.Domain\KyberWeave.Domain.csproj" />
  </ItemGroup>

  <!-- Each area owns one Areas\<Area>.props for its resources and package references, so parallel moves never edit the same lines. -->
  <Import Project="Areas\*.props" />

</Project>
