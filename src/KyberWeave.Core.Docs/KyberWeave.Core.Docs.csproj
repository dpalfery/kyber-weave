<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>KyberWeave.Core.Docs</PackageId>
    <Version>0.1.0</Version>
    <Authors>KyberWeave</Authors>
    <Description>The DocGraph engine: parses, validates, searches, exports, scaffolds and drift-checks the governed documentation corpus.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KyberWeave.Tests" />
    <InternalsVisibleTo Include="KyberWeave.Integration.Tests" />
    <InternalsVisibleTo Include="KyberWeave.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time only, as in KyberWeave.Core: see the note there. -->
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyberWeave.Core\KyberWeave.Core.csproj" />
    <ProjectReference Include="..\KyberWeave.Domain\KyberWeave.Domain.csproj" />
    <ProjectReference Include="..\KyberWeave.Application\KyberWeave.Application.csproj" />
  </ItemGroup>

</Project>
