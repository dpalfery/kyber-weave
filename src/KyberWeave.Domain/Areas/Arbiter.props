<Project>

  <ItemGroup>
    <!-- The 18 shipped Arbiter rules plus the test-file patterns and the LENS-001 step-0 path table: the
         single source of truth for defaults. ArbiterConfigLoader reads it by this logical name, so the
         reader and the file stay in the same assembly. -->
    <EmbeddedResource Include="Arbiter\Rules\default-rules.yml" LogicalName="Arbiter.default-rules.yml" />
    <!-- Embedded Squad copies the Arbiter reads in host repositories without a canonical tree.
         ArbiterSquadCatalog reads them by these logical names. The names mirror the Standards.* convention
         and avoid the raw-corpus tokens the release test forbids in resource names. -->
    <EmbeddedResource Include="..\..\products\kyber-squad\agents\*.md" LogicalName="Arbiter.Roster.%(Filename).md" />
    <EmbeddedResource Include="..\..\products\kyber-squad\skills\code-review\references\lenses\*.md" LogicalName="Arbiter.Lens.%(Filename).md" />
  </ItemGroup>

</Project>
