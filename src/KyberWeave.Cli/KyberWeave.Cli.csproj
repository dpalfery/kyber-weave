<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KyberWeave.Cli</RootNamespace>
    <AssemblyName>kyber-weave</AssemblyName>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kyber-weave</ToolCommandName>
    <PackageId>KyberWeave.Tool</PackageId>
    <Authors>KyberWeave</Authors>
    <Description>Kyber-Weave governance CLI: validate, lint, security-scan and drift-check skills, agent definitions and documentation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KyberWeave.Cli.Tests" />
    <InternalsVisibleTo Include="KyberWeave.Integration.Tests" />
    <InternalsVisibleTo Include="KyberWeave.Testing" />
    <ProjectReference Include="..\KyberWeave.Application\KyberWeave.Application.csproj" />
  </ItemGroup>

</Project>
