<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests whose subject is the repository itself: its scripts, CI workflows, review-gate
    configuration, documentation and source layout. They reference Core only (for the process
    runner they drive scripts with), so they build without the hosts and feature assemblies,
    and a C#-only change can skip them. See AGENTS.md in this directory for what belongs here.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CA1707: xUnit test methods are named Method_Condition_Expectation. xUnit1051: the v3 cancellation token is not threaded through. -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- The classes keep the KyberWeave.Tests namespace they had before the catch-all project was retired,
         so a fully-qualified class name means the same test as before. -->
    <RootNamespace>KyberWeave.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository-root locator, the disposable temp directory and the per-process temp
         root all live in the shared test library now, so this project references the one copy
         instead of compiling source files from another test project. -->
    <ProjectReference Include="..\..\src\KyberWeave.Kernel\KyberWeave.Kernel.csproj" />
    <ProjectReference Include="..\KyberWeave.Testing\KyberWeave.Testing.csproj" />
  </ItemGroup>

</Project>
