<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests: a test that performs a real Squad deployment, starts a real program, or
    needs a file system beyond its own scratch folder lives here. The unit project keeps the
    in-memory tests and must finish inside the two-minute budget.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- xUnit test method names use underscores, and the v3 cancellation token is not threaded through. -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>

    <!-- CA2000: the shared `DocFixture` lives in
         KyberWeave.Testing, and the analyzer cannot follow its fluent methods across assemblies. -->
    <NoWarn>$(NoWarn);CA2000</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.MTP" Version="10.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" PrivateAssets="all" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyberWeave.Testing\KyberWeave.Testing.csproj" />
    <ProjectReference Include="..\..\src\KyberWeave.Arbiter\KyberWeave.Arbiter.csproj" />
    <ProjectReference Include="..\..\src\KyberWeave.Cli\KyberWeave.Cli.csproj" />
    <ProjectReference Include="..\..\src\KyberWeave.Mcp\KyberWeave.Mcp.csproj" />
  </ItemGroup>

</Project>
