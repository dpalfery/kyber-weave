<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>
    <!-- CA2000: test consoles and HTTP handlers are held in fields or returned by helpers and are
         disposed by the test class; the analyzer cannot follow that. Same exemption as the other test projects. -->
    <NoWarn>$(NoWarn);CA2000</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>KyberWeave.Application.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixture files the classes read are embedded, so a unit test holds them in memory. The integration project reads
         the same hook payloads from this folder by path. -->
    <EmbeddedResource Include="Fixtures\arbiter-hooks\**\*.json" LogicalName="fixtures/arbiter-hooks/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures\review-seats\*.md" LogicalName="fixtures/review-seats/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures\arbiter-plans\*.md" LogicalName="fixtures/arbiter-plans/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KyberWeave.Application\KyberWeave.Application.csproj" />
    <ProjectReference Include="..\..\src\KyberWeave.Contracts\KyberWeave.Contracts.csproj" />
    <ProjectReference Include="..\..\src\KyberWeave.Domain\KyberWeave.Domain.csproj" />
    <ProjectReference Include="..\KyberWeave.Testing\KyberWeave.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded gate reports the RED tests judge: compiled in, so a test reads them without the disk. -->
    <EmbeddedResource Include="Fixtures\red-gate-reports\*.json" LogicalName="red-gate-reports/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
