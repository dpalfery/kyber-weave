<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>
    <!-- CA2000: test consoles and HTTP handlers are held in fields or returned by helpers and are
         disposed by the test class; the analyzer cannot follow that. Same exemption as KyberWeave.Tests. -->
    <NoWarn>$(NoWarn);CA2000</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>KyberWeave.Cli.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KyberWeave.Cli\KyberWeave.Cli.csproj" />
    <ProjectReference Include="..\KyberWeave.Testing\KyberWeave.Testing.csproj" />
  </ItemGroup>

</Project>
