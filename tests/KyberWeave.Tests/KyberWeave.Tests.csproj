<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The repository rule is that a warning fails the build (Directory.Build.props,
         TreatWarningsAsErrors + AnalysisMode=all). This project now holds to it. The
         blanket `false` that used to sit here was an unexplained exemption, and 270
         analyzer warnings accumulated behind it: it silenced nothing (they all still
         printed) and enforced nothing (real defects sat in the noise). Anything that
         genuinely should not be fixed is suppressed below or at its site, with a
         reason, per the NoWarn rule in AGENTS.md. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- CA1707 (192 sites): xUnit tests here are named Method_Condition_Expectation.
         The rule exists to keep underscores out of public API identifiers; test
         methods are not API, and renaming the suite would lose the convention that
         makes a failing test name readable. Scoped to this project so the rule stays
         armed across src/. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>

    <!-- xUnit1051 (194 sites): xunit v3 asks every call that accepts a CancellationToken
         to pass TestContext.Current.CancellationToken, so a cancelled run stops sooner.
         The suite moved to v3 for its native dynamic skip, which v2 reported as a failure;
         threading the token through every call is a responsiveness change, not a defect
         fix, and no test here relies on cancellation. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>

    <!-- CA2000 (dispose before losing scope) cannot see the shared `DocFixture` in
         tests/KyberWeave.Testing: its fluent WithCatalog/Write methods and the helpers that
         take and return it hand back the same instance, which its owner disposes with `using`,
         but the analyzer only follows that inside one assembly and reports every call site.
         Suppressed for this project alone; it stays armed in src/. -->
    <NoWarn>$(NoWarn);CA2000</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.MTP" Version="10.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" PrivateAssets="all" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyberWeave.Testing\KyberWeave.Testing.csproj" />
    <ProjectReference Include="..\..\src\KyberWeave.Arbiter\KyberWeave.Arbiter.csproj" />
    <ProjectReference Include="..\..\src\KyberWeave.Cli\KyberWeave.Cli.csproj" />
    <ProjectReference Include="..\..\src\KyberWeave.Mcp\KyberWeave.Mcp.csproj" />
  </ItemGroup>

</Project>
