<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Content tests: checks of the content this repository ships (agents, skills, standards,
    documents, workflows). They read it through the corpus seam in the shared test library, write
    nothing and start no program. See AGENTS.md in this directory.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CA1707: xUnit test methods are named Method_Condition_Expectation. xUnit1051: the v3 cancellation token is not threaded through. -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- The classes keep the KyberWeave.Tests namespace they had before the catch-all project was retired,
         so a fully-qualified class name means the same test as before. -->
    <RootNamespace>KyberWeave.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The corpus seam lives in the shared test library, so this project references the one copy
         rather than compiling a source file from another test project. -->
    <ProjectReference Include="..\KyberWeave.Testing\KyberWeave.Testing.csproj" />
  </ItemGroup>

</Project>
