<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests that assert the wording of governed content: skill, agent and instruction markdown and
    the yaml they ship with. They read product files as text and check tokens, phrases and
    markers. They reference no product assembly, so they build without the hosts and feature
    assemblies. The checks are scheduled to become eval-style. See AGENTS.md in this directory.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Same two suppressions, for the same reasons, as KyberWeave.Tests.csproj. -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- The classes keep the namespace they had in KyberWeave.Tests, so a fully-qualified class
         name (CI filters, scripts/fast-loop-classes.txt) means the same test in either project. -->
    <RootNamespace>KyberWeave.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with KyberWeave.Tests rather than copied: the repository-root locator. -->
    <Compile Include="..\KyberWeave.Tests\KyberWeaveTestPaths.cs" Link="Shared\KyberWeaveTestPaths.cs" />
  </ItemGroup>

</Project>
