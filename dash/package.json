{
  "name": "kyberdash",
  "version": "0.9.23",
  "description": "Context health reports and dashboards for AI coding sessions",
  "type": "module",
  "main": "./web/dist/index.html",
  "private": true,
  "scripts": {
    "build": "npm run build:web",
    "build:web": "cd web && npm install --no-audit --no-fund --silent && npm run build",
    "test": "vitest run tests scripts web/src",
    "test:related": "vitest related --run",
    "check:reachable": "node scripts/unreachable.mjs",
    "test:watch": "vitest tests scripts web/src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint ."
  },
  "keywords": [
    "claude-code",
    "cursor",
    "codex",
    "kimi",
    "devin",
    "ibm-bob",
    "opencode",
    "pi",
    "codebuff",
    "codewhale",
    "dsh",
    "ai-coding",
    "token-usage",
    "cost-tracking",
    "observability",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "Dave Palfery <dpalfery@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpalfery/kyber-weave.git"
  },
  "bugs": {
    "url": "https://github.com/dpalfery/kyber-weave/issues"
  },
  "homepage": "https://github.com/dpalfery/kyber-weave#readme",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.18.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.61.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
