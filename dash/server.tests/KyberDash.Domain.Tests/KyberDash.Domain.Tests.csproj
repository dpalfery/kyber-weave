<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- reason: xUnit test method underscores (CA1707), nested test fixtures (CA1034), fake interface parameter names (CA1725), List<T> in test fakes (CA1002), and synchronous test cancellation tokens (xUnit1051). -->
    <NoWarn>$(NoWarn);CA1707;CA1034;CA1725;CA1002;xUnit1051</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>KyberDash.Domain.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\KyberDash.Application\KyberDash.Application.csproj" />
    <ProjectReference Include="..\..\server\KyberDash.Contracts\KyberDash.Contracts.csproj" />
    <ProjectReference Include="..\..\server\KyberDash.Core\KyberDash.Core.csproj" />
    <ProjectReference Include="..\..\server\KyberDash.Domain\KyberDash.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\KyberDash.Application.Tests\Fakes\InMemoryRelationalStore.cs" Link="Fakes\InMemoryRelationalStore.cs" />
  </ItemGroup>

</Project>
