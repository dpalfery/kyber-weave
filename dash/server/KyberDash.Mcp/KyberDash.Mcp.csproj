<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KyberDash.Mcp</RootNamespace>
    <AssemblyName>kyberdash-mcp</AssemblyName>
    <Authors>KyberWeave</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KyberDash.Application.Tests" />
    <InternalsVisibleTo Include="KyberDash.Presentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyberDash.Application\KyberDash.Application.csproj" />
    <ProjectReference Include="..\KyberDash.Contracts\KyberDash.Contracts.csproj" />
    <ProjectReference Include="..\KyberDash.Core\KyberDash.Core.csproj" />
    <ProjectReference Include="..\KyberDash.Domain\KyberDash.Domain.csproj" />
  </ItemGroup>

</Project>
