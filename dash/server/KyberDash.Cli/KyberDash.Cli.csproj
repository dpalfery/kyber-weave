<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KyberDash.Cli</RootNamespace>
    <AssemblyName>kyberdash</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kyberdash</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>KyberDash.Cli</PackageId>
    <Authors>KyberWeave</Authors>
    <Description>KyberDash standalone CLI and process coordinator.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyberDash.Application\KyberDash.Application.csproj" />
    <ProjectReference Include="..\KyberDash.Contracts\KyberDash.Contracts.csproj" />
    <ProjectReference Include="..\KyberDash.Core\KyberDash.Core.csproj" />
    <ProjectReference Include="..\KyberDash.Domain\KyberDash.Domain.csproj" />
  </ItemGroup>

</Project>
