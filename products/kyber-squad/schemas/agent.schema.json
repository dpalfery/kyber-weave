{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyber-weave.dev/schemas/kyber-squad/agent/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "description",
    "invocation",
    "model-profile",
    "capability-profile",
    "delegates-to",
    "fallback",
    "aliases"
  ],
  "properties": {
    "schema": { "const": "kyber-squad.agent/v1" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "invocation": { "enum": ["primary", "subagent"] },
    "model-profile": { "type": "string", "minLength": 1 },
    "capability-profile": { "type": "string", "minLength": 1 },
    "delegates-to": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fallback": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
