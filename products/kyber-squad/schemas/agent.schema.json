{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyber-weave.dev/schemas/kyber-squad/agent/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "description",
    "invocation",
    "model-profile",
    "capability-profile",
    "copilot-tools",
    "delegates-to",
    "fallback",
    "aliases"
  ],
  "properties": {
    "schema": { "const": "kyber-squad.agent/v1" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "invocation": { "enum": ["primary", "subagent"] },
    "model-profile": { "type": "string", "minLength": 1 },
    "capability-profile": { "type": "string", "minLength": 1 },
    "copilot-capability-profile": { "type": "string", "minLength": 1 },
    "copilot-tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "vscode",
          "read",
          "todo",
          "codegraph/*",
          "kyber-weave/*",
          "context7/*",
          "search",
          "execute",
          "web",
          "edit",
          "agent",
          "edit/createDirectory",
          "edit/createFile",
          "edit/editFiles",
          "edit/rename",
          "vscodeGeneral/rename"
        ]
      }
    },
    "delegates-to": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fallback": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
