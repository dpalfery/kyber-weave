{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KyberDash: OTel Trace Collector (Port 4318)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/dash",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--no-deprecation",
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/dash/src/launcher.ts",
      "args": [
        "otel",
        "--port",
        "4318"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "KyberDash: Terminal TUI Dashboard",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/dash",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--no-deprecation",
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/dash/src/launcher.ts",
      "args": [],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "KyberDash: Terminal TUI Dashboard (Custom Args)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/dash",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--no-deprecation",
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/dash/src/launcher.ts",
      "args": [
        "${input:tuiArgs}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "KyberDash: Web Dashboard (Browser Frontend)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:4747",
      "webRoot": "${workspaceFolder}/dash/web",
      "sourceMaps": true,
      "preLaunchTask": "kyberdash:run-supporting-system"
    },
    {
      "name": "KyberDash: Web Dashboard (CLI Server - Auto-Open Browser)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/dash",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--no-deprecation",
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/dash/src/launcher.ts",
      "args": [
        "web",
        "--port",
        "4747"
      ],
      "preLaunchTask": "kyberdash:build-supporting-system",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "KyberDash: Web Dashboard (CLI Server)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/dash",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--no-deprecation",
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/dash/src/launcher.ts",
      "args": [
        "web",
        "--port",
        "4747",
        "--no-open"
      ],
      "preLaunchTask": "kyberdash:build-supporting-system",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "KyberDash: Web Dashboard (Browser on Port 4747)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:4747",
      "webRoot": "${workspaceFolder}/dash/web",
      "sourceMaps": true
    },
    {
      "name": "KyberDash: Web Dashboard (Vite HMR Dev - Port 5173)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/dash/web/src",
      "sourceMaps": true,
      "preLaunchTask": "kyberdash:run-vite-dev-system"
    },
    {
      "name": "KyberDash: Menubar Tray (Rust Backend - LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/dash/tray/src-tauri/target/debug/kyberdash-tray",
      "windows": {
        "program": "${workspaceFolder}/dash/tray/src-tauri/target/debug/kyberdash-tray.exe"
      },
      "cwd": "${workspaceFolder}/dash/tray/src-tauri",
      "env": {
        "KYBERDASH_BIN": "${workspaceFolder}/dash/dist/cli.js"
      },
      "preLaunchTask": "kyberdash:build-tauri-debug"
    },
    {
      "name": "KyberDash: Menubar Tray (Rust Backend - Windows MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/dash/tray/src-tauri/target/debug/kyberdash-tray.exe",
      "cwd": "${workspaceFolder}/dash/tray/src-tauri",
      "preLaunchTask": "kyberdash:build-tauri-debug"
    },
    {
      "name": "KyberDash: Menubar Tray (Popover Frontend)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:1420",
      "webRoot": "${workspaceFolder}/dash/tray/ui/src",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "KyberDash: Web Dashboard (Full Stack: CLI Server + Browser)",
      "configurations": [
        "KyberDash: Web Dashboard (CLI Server)",
        "KyberDash: Web Dashboard (Browser on Port 4747)"
      ],
      "stopAll": true
    },
    {
      "name": "KyberDash: Web Dashboard (Full Stack: CLI Server + Vite HMR Dev)",
      "configurations": [
        "KyberDash: Web Dashboard (CLI Server)",
        "KyberDash: Web Dashboard (Vite HMR Dev - Port 5173)"
      ],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "tuiArgs",
      "type": "promptString",
      "description": "Enter CLI flags for KyberDash TUI (e.g. '--period week' or '--provider claude')",
      "default": ""
    }
  ]
}
