{
  "name": "Kyber-Weave",
  "install": "bash .cursor/cloud-agent-install.sh",
  "mcpServerAllowlist": [
    {
      "name": "kw-docs",
      "command": "*kyber-weave-mcp --repo-root *"
    },
    {
      "name": "codegraph",
      "command": "*codegraph serve --mcp --path *"
    },
    {
      "name": "azure-mcp",
      "command": "azmcp"
    },
    {
      "name": "github",
      "command": "github-mcp-server"
    },
    {
      "name": "context7",
      "serverUrl": "https://mcp.context7.com/mcp"
    },
    {
      "name": "microsoft-learn",
      "serverUrl": "https://learn.microsoft.com/api/mcp"
    }
  ]
}
