{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "kyber-weave-arbiter hook --harness cursor",
        "matcher": "Task",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "kyber-weave-arbiter hook --harness cursor",
        "matcher": "Task",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "sessionStart": [
      {
        "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$root\" ] && bash \"$root/scripts/codegraph-session-index.sh\"; exit 0",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
