{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "kyber-weave-arbiter hook --harness cursor",
        "matcher": "Task",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "kyber-weave-arbiter hook --harness cursor",
        "matcher": "Task",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "sessionStart": [
      {
        "command": "command -v kyber-weave >/dev/null 2>&1 && root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && [ -n \"$root\" ] && { (cd \"$root\" && kyber-weave doctor --ensure . >/dev/null 2>&1 &); }; exit 0",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
