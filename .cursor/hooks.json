{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "kyber-weave-arbiter hook --harness cursor",
        "matcher": "Task",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "kyber-weave-arbiter hook --harness cursor",
        "matcher": "Task",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "sessionStart": [
      {
        "command": "bash \"$(git rev-parse --show-toplevel)/scripts/codegraph-session-index.sh\""
      }
    ]
  }
}
