{
  "mcpServers": {
    "kyber-weave": {
      "type": "stdio",
      "command": "kyber-weave-mcp",
      "args": ["--repo-root", "."],
      "env": {
        "PATH": "${HOME}/.local/bin:${PATH}"
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp", "--path", "."],
      "env": {
        "PATH": "${HOME}/.local/bin:${PATH}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
