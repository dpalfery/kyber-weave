<Project>
  <!--
    Standalone Kyber-Weave repo defaults (analyzers / nullable / language).
    This tree does not import a parent Directory.Build.props.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-All</AnalysisLevel>
    <AnalysisMode>all</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzers>true</RunAnalyzers>
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);S1451;S1128;S122;S113;S109;S121;S4055;S4056;S4058;CA1822;CA2007;CA1031;CA1860;CA1873;CA1848;CA1852;CA1859;CA1001;CA1063;CA2227;CA4004;S3776;S138;S134;S126;S1541;S3242;S3260;S3353;S2325;S1643;S1449;S1135;CA1805;CA1515;S3059;CA1502;CA1062;CA1506</NoWarn>
  </PropertyGroup>
</Project>
