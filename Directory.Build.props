<Project>
  <!--
    Standalone Kyber-Weave repo defaults (analyzers / nullable / language).
    This tree does not import a parent Directory.Build.props.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-All</AnalysisLevel>
    <AnalysisMode>all</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzers>true</RunAnalyzers>
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">false</GenerateDocumentationFile>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>

    <!-- NuGet Audit: HIGH/CRITICAL fail the build (NU1903/NU1904). Low/moderate stay
         warnings so advisory noise does not block unrelated work. Explicit Mode=all
         matches the net10.0 default and documents intent for transitive packages. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);S1451;S1128;S122;S113;S109;S121;S4055;S4056;S4058;CA1822;CA2007;CA1860;CA1873;CA1848;CA1852;CA1859;CA4004;S3776;S138;S134;S126;S1541;S3242;S3260;S3353;S2325;S1643;S1449;S1135;CA1805;CA1515;S3059</NoWarn>
  </PropertyGroup>
  <!--
    Analyzer ratchet (docs/todo/csharp-standards-remediation.md). The rules in
    analyzers/ratchet.globalconfig enforce the C# coding standard but still have violations, so they
    are held at suggestion. Fixing a rule to zero removes its line there, and from then on the
    rule fails the build like every other warning. Build with -p:KwAnalyzerAudit=true to see every
    remaining violation as a warning: pass -p:TreatWarningsAsErrors=false as well, on the command
    line, because test projects set that property themselves.
  -->
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)analyzers/rules.globalconfig" />
  </ItemGroup>
  <ItemGroup Condition="'$(KwAnalyzerAudit)' != 'true'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)analyzers/ratchet.globalconfig" />
  </ItemGroup>
</Project>
