# Kyber-Weave EditorConfig — whitespace + a small curated style set.
# Quality/security stay on Roslyn CA (AnalysisMode=all) and CI SAST; this file
# only drives `dotnet format whitespace` / `dotnet format style`.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,props,targets,xml,csproj,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4

# Keep Style/Naming/Formatting/Documentation off at *build* time so
# TreatWarningsAsErrors stays focused on CA quality rules. Individual IDE
# severities below still drive `dotnet format style --severity warn`.
dotnet_analyzer_diagnostic.category-Style.severity = none
dotnet_analyzer_diagnostic.category-Naming.severity = none
dotnet_analyzer_diagnostic.category-Formatting.severity = none
dotnet_analyzer_diagnostic.category-Documentation.severity = none

# --- Curated style pack (matches existing codebase conventions) ---

# File-scoped namespaces (entire tree uses these)
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning

# Prefer language keywords over BCL type names for locals/members
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_diagnostic.IDE0049.severity = warning

# var when the type is apparent or built-in (repo already prefers var)
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:suggestion
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = suggestion

# Braces / newlines — light touch
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Explicitly silence common Sonar / style rule IDs considered noise
# (vestigial from parent-tree history; SonarAnalyzer is not referenced here).
dotnet_diagnostic.S103.severity = none
dotnet_diagnostic.S3059.severity = none
dotnet_diagnostic.S1227.severity = none
dotnet_diagnostic.S2302.severity = none
dotnet_diagnostic.S1172.severity = none
dotnet_diagnostic.S2360.severity = none
dotnet_diagnostic.S1200.severity = none
dotnet_diagnostic.S4487.severity = none
dotnet_diagnostic.S3776.severity = none

# Naming Rules (CA1700-1799) - TREAT AS SUGGESTION
dotnet_diagnostic.CA1700.severity = suggestion
dotnet_diagnostic.CA1701.severity = suggestion
dotnet_diagnostic.CA1702.severity = suggestion
