**/bin/
!npm/bin/
!npm/bin/**
obj/
*.user
.vs/
nupkg/
*.nupkg
/TestResults/
# Playwright (and similar) output at any depth. Distinct from /TestResults/
# above, which is the .NET VSTest directory at the repo root.
test-results/
# Agent working notes, lint dumps, and screenshots. Never product.
.agents-scratchpad/
*.sarif
.DS_Store
/artifacts/
/npm/vendor/
/npm/*.tgz

# CodeGraph index — host-owned and machine-local. Kyber-Weave reads it read-only
# and never creates it; the daemon rebuilds it per machine.
.codegraph/

# Local DOTNET_CLI_HOME used when the sandbox blocks ~/.dotnet first-run paths.
.dotnet-home/

# APM deploy target. Skills are authored in .apm/skills/ and `apm install` copies
# them here, so this is generated output — including skills from other packages.
.agents/
apm_modules/
# Cursor MCP secrets (keep .cursor/mcp.json tracked)
.cursor/**/*.env
.cursor/**/*.env.*
!.cursor/**/*.env.example

node_modules/

.local-release/

# --- dash/ build output ---
# The same patterns as dash/.gitignore, mirrored here so the rule survives a
# package-side change and is visible to anyone scanning repo-root ignores.
dash/dist/
dash/**/dist/
dash/build/
dash/.tsbuildinfo
dash/**/*.tsbuildinfo
dash/**/*.tgz
dash/tray/src-tauri/target/

# The root `**/bin/` rule targets .NET project output. Vendored upstream has
# no `bin/` directory currently, so the rule does not swallow an upstream
# directory. If upstream ever ships a directory named `bin/` it would be
# ignored — that is desirable, since it would be build artifact there too.

# design-sync (claude.ai/design import) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
dash/app/types/
dash/app/.ds-sync-styles.css
