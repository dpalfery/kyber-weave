**/bin/
!npm/bin/
!npm/bin/**
obj/
*.user
.vs/
nupkg/
*.nupkg
/TestResults/
*.sarif
.DS_Store
/artifacts/
/npm/vendor/
/npm/*.tgz

# CodeGraph index — host-owned and machine-local. Kyber-Weave reads it read-only
# and never creates it; the daemon rebuilds it per machine.
.codegraph/

# Local DOTNET_CLI_HOME used when the sandbox blocks ~/.dotnet first-run paths.
.dotnet-home/

# APM deploy target. Skills are authored in .apm/skills/ and `apm install` copies
# them here, so this is generated output — including skills from other packages.
.agents/
apm_modules/
# Cursor MCP secrets (keep .cursor/mcp.json tracked)
.cursor/**/*.env
.cursor/**/*.env.*
!.cursor/**/*.env.example

node_modules/

.local-release/

# --- dash/ subtree (vendored from getagentseal/codeburn via git subtree) ---
# The upstream's own dash/.gitignore already lists its build output, but the
# same patterns live here so the rule survives a vendor-side change and is
# visible to anyone scanning repo-root ignores. Vendored code is never built
# by KyberWeave itself — KyberDash consumes upstream's published output.
dash/dist/
dash/**/dist/
dash/build/
dash/.tsbuildinfo
dash/**/*.tsbuildinfo
dash/**/*.tgz

# The root `**/bin/` rule targets .NET project output. Vendored upstream has
# no `bin/` directory currently, so the rule does not swallow an upstream
# directory. If upstream ever ships a directory named `bin/` it would be
# ignored — that is desirable, since it would be build artifact there too.
